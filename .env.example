# Optional overrides; copy to .env and uncomment what you need.
# ASR_GPU=0
# API_KEY=your_api_key_here
# HF_HUB_OFFLINE=1
# HF_ENDPOINT=https://hf-mirror.com

# GPU memory budget, as a fraction of the whole card.
# R2T2_GPU_MEMORY_UTILIZATION=0.30
# FORCED_ALIGNER_GPU_MEMORY_UTILIZATION=0.15

# Realtime decode interval in seconds (GPU and CPU); allowed range: 0.08–2.
# R2T2_CHUNK_SECONDS=0.64

# CPU threads.
# R2T2_CPU_THREADS=8
# OPENBLAS_NUM_THREADS=8

# Word timing: forced uses the aligner; uniform estimates timing without it.
# ALIGNMENT_MODE=forced
